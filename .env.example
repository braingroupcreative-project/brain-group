# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://www.exemple-braingroup.com
NEXT_PUBLIC_WHATSAPP_NUMBER=225XXXXXXXXXX      # format international sans + ni espaces
NEXT_PUBLIC_PHONE=+225 XX XX XX XX XX
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_ADDRESS=Abidjan, Côte d'Ivoire

# ---------- Base de données + stockage privé (Supabase) ----------
# Si absentes : mode local (fichiers dans .data/) — NE PAS utiliser en production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                      # secret : jamais côté navigateur
SUPABASE_BUCKET=brain-private

# ---------- Authentification admin ----------
AUTH_SECRET=                                    # 32+ caractères aléatoires (openssl rand -base64 48)
ADMIN_EMAIL=                                    # compte administrateur initial
ADMIN_PASSWORD=                                 # mot de passe initial (à changer ensuite)

# ---------- E-mails (Resend) ----------
RESEND_API_KEY=
MAIL_FROM=Brain Group <devis@votre-domaine.com> # domaine vérifié chez Resend
TEAM_EMAIL=braingroupcreative@gmail.com

# ---------- Tâches planifiées ----------
CRON_SECRET=                                    # Vercel l'envoie en Bearer automatiquement

# ---------- Pixels publicitaires (facultatifs ; chargés seulement après consentement du visiteur) ----------
NEXT_PUBLIC_META_PIXEL_ID=                      # Meta (Facebook/Instagram) : ID du pixel, 15-16 chiffres
NEXT_PUBLIC_TIKTOK_PIXEL_ID=                    # TikTok : ID du pixel
NEXT_PUBLIC_GA_ID=                              # Google Analytics 4 : G-XXXXXXXXXX
NEXT_PUBLIC_GADS_ID=                            # Google Ads : AW-XXXXXXXXX
NEXT_PUBLIC_GADS_LEAD_LABEL=                    # Google Ads : étiquette de conversion « demande de devis »
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=           # Meta Business : code de vérification du domaine
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=           # Google Search Console : code de vérification
